<nxml-page><Page Key="ExamplePluginPage" Label="{{TITLE}}"><StackPanel Orientation="Vertical" Spacing="16" Padding="24"><Text Content="Plugin page / 插件页面" FontSize="24" /><Text Content="This page is rendered by the Host. The action runs in PluginSidecar." /><Button Key="ExamplePluginAction" Content="Run action / 执行操作" Command="ui.plugin.action" Argument="{{PLUGIN_ID}}:hello" Width="220" Height="44" /></StackPanel></Page></nxml-page>
